 "poems": [
  {
   "seq": "1",
   "text": "時鳥み山なからのはつ聲をこけの枕にあかつきそきく",
   "kana": "",
   "speaker": "",
   "page": 241,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "これまてそ鳥の音もする時鳥あすはふもとのよその白雲",
   "kana": "",
   "speaker": "",
   "page": 241,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "ちきりをかぬ淚そかよふ郭公誰も旅なる夜半のねさめに",
   "kana": "",
   "speaker": "",
   "page": 241,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "明わたるみねの梯こえやらてきけはすき行ほとゝきすかな",
   "kana": "",
   "speaker": "",
   "page": 241,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "露分る山時鳥をのれまたなく音をそへて袖しほるらん",
   "kana": "",
   "speaker": "",
   "page": 241,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "今夜ぬるは山かみれの雲路にも猶こえ遠きほとゝきすかな",
   "kana": "",
   "speaker": "",
   "page": 241,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "旅の空行かふ山のほとゝきす都へたつる雲になくなり",
   "kana": "",
   "speaker": "",
   "page": 241,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "郭公われも旅なりかち人の花たち花をそことおしへよ",
   "kana": "",
   "speaker": "",
   "page": 242,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "駒とむる野中の森は立にけり鳴や向の山ほとゝきす",
   "kana": "",
   "speaker": "",
   "page": 242,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "夏川や淺瀨になひくにこ草のにこらぬ水の色そ凉しき",
   "kana": "",
   "speaker": "",
   "page": 242,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "茂りあふ草はみなからかけみえてをのれ浪こす野路の玉河",
   "kana": "",
   "speaker": "",
   "page": 242,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "河の瀨に夜わたる舟の此ころはかるやまこもの亂てそゆく",
   "kana": "",
   "speaker": "",
   "page": 242,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "山河の岩もと小菅浪こえて木かけ凉しき夏の夕暮",
   "kana": "",
   "speaker": "",
   "page": 242,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "からすとも結はさらめやまこも草たかせのよとの枕はかりに",
   "kana": "",
   "speaker": "",
   "page": 242,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "ふみ分ぬ谷の夏草しけるらし此ころほそき山河の水",
   "kana": "",
   "speaker": "",
   "page": 242,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "日數ふる淀のわたりの村雨にからぬまこもや末亂るらむ",
   "kana": "",
   "speaker": "",
   "page": 242,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "浪こゆる河瀨にちかきさゝのよのみしかく明る夢そはかなき",
   "kana": "",
   "speaker": "",
   "page": 242,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "こえかねてげふもくらしつ時鳥なく山のはにいつる月かけ",
   "kana": "",
   "speaker": "",
   "page": 242,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "夏草の道のへ深きおもひ川むすはぬ水のかけはなひかて",
   "kana": "",
   "speaker": "",
   "page": 242,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "夏くれは玉島川にかる草の浪もてゆへる色そ凉しき",
   "kana": "",
   "speaker": "",
   "page": 242,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "今そしる北野の松の陰しけみあまるは神の惠なりけり",
   "kana": "",
   "speaker": "",
   "page": 242,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "住吉の松をいはゝんためしには君の御代をそ引へかりける",
   "kana": "",
   "speaker": "",
   "page": 242,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "あらはれよ松にそ君をとはかりに思そめてし行末の色",
   "kana": "",
   "speaker": "",
   "page": 242,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "黑髪の霜より後も年ふりて松の位の山そはるけき",
   "kana": "",
   "speaker": "",
   "page": 242,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "身のうへを思ふね覺の深夜に涙くたくる松の風かな",
   "kana": "",
   "speaker": "",
   "page": 242,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "おもふ事ちゝに心を木枯の松にくたけてすくる比かな",
   "kana": "",
   "speaker": "",
   "page": 242,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "君か代の猶行末のみねの松おひぬる身こそたのみかたけれ",
   "kana": "",
   "speaker": "",
   "page": 242,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "萬代と分てそあふく玉松のおなしみとりを袖にかけつゝ",
   "kana": "",
   "speaker": "",
   "page": 242,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "花の下紅葉のよそにじほれつゝうき年深き松はふりにき",
   "kana": "",
   "speaker": "",
   "page": 242,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "去年の春袖にほしてし松の露猶としあらは身をなしほりそ",
   "kana": "",
   "speaker": "",
   "page": 242,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "鈴虫の聲ふるさとの秋の夜はむすふ夢さへおとろかれけり",
   "kana": "",
   "speaker": "",
   "page": 242,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "見る夢を枕のしたの虫の音におとろかされて有明の空",
   "kana": "",
   "speaker": "",
   "page": 242,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "我さへに夢をのこしつきり〓〓す蓬か杣に秋やふけぬる",
   "kana": "",
   "speaker": "",
   "page": 242,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "思ひねのあふ夢やふる虫の音はうさも哀もおなしかりけり",
   "kana": "",
   "speaker": "",
   "page": 242,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
